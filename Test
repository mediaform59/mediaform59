      <h2>3. Condensateurs Installés (µF)</h2>
      <label>C1 Liaison Entrée (µF) <input id="ac_c1" type="number" value="10" step="0.1" oninput="simAC()"></label>
      <label>C2 Liaison Sortie (µF) <input id="ac_c2" type="number" value="10" step="0.1" oninput="simAC()"></label>
      <label>CE Découplage (µF) <input id="ac_ce" type="number" value="100" step="1" oninput="simAC()"></label>
      <hr style="border:0; border-top:1px solid #e2e8f0; margin:8px 0;">
      <label>Cπ / Cbe (pF) <input id="ac_cpi" type="number" value="25" step="1" oninput="simAC()"></label>
      <label>Cμ / Cbc (pF) <input id="ac_cmu" type="number" value="2.5" step="0.1" oninput="simAC()"></label>
      <label>VT Température (mV) <input id="ac_vt" type="number" value="26" step="0.5" oninput="simAC()"></label>
      <button type="button" style="margin-top:6px;" onclick="simAC()">Re-simuler les Courbes</button>
    </section>

    <section class="card wide">
