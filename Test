      <canvas id="acSchematicCanvas" width="1000" height="240"></canvas>
    </section>

    <section class="card wide">
      <h2>Performances de l'Amplificateur (Gains & Fréquences de Coupure)</h2>
      <div id="resAC" class="results"></div>
    </section>

    <section class="card wide">
