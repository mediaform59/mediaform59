function drawLoadLine(canvasId, params) {
        var canvas = document.getElementById(canvasId);
        if (!canvas) return;
        var ctx = canvas.getContext("2d");

        var vcc = params.vcc || 12;                 
        var rc = params.rc || 220;                  
        var re = params.re || 47;                   
        var vce_q = params.vce_q || 4.70;           
        var ic_q_mA = params.ic_q_mA || 27.91;      

        var vce_max = vcc;                          
        var ic_sat_mA = (rc + re > 0) ? (vcc / (rc + re)) * 1000 : 0;   

        var width = canvas.width;
        var height = canvas.height;
        var padding = { top: 30, right: 50, bottom: 40, left: 60 };

        var graphW = width - padding.left - padding.right;
        var graphH = height - padding.top - padding.bottom;

        var xMax = Math.max(vce_max * 1.15, 10);
        var yMax = Math.max(ic_sat_mA * 1.15, 10);

        function toX(vce) { return padding.left + (vce / xMax) * graphW; }
        function toY(ic) { return height - padding.bottom - (ic / yMax) * graphH; }

        ctx.clearRect(0, 0, width, height);

        // Axes
        ctx.beginPath();
        ctx.strokeStyle = "#333";
        ctx.lineWidth = 1.5;
        ctx.moveTo(padding.left, padding.top);
        ctx.lineTo(padding.left, height - padding.bottom);
        ctx.lineTo(width - padding.right, height - padding.bottom);
        ctx.stroke();

        // Titres des axes
        ctx.fillStyle = "#333";
        ctx.font = "bold 12px sans-serif";
        ctx.fillText("VCE (V)", width - padding.right - 20, height - padding.bottom + 30);
        ctx.fillText("IC (mA)", padding.left - 45, padding.top - 10);

        // Droite de charge DC
        var x1 = toX(0), y1 = toY(ic_sat_mA);
        var x2 = toX(vce_max), y2 = toY(0);

        ctx.beginPath();
        ctx.strokeStyle = "#2563eb"; 
        ctx.lineWidth = 2.5;
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();

        // Point Saturation sur l'Axe Y
        ctx.beginPath();
        ctx.arc(x1, y1, 5, 0, 2 * Math.PI);
        ctx.fillStyle = "#2563eb";
        ctx.fill();
        ctx.font = "bold 11px sans-serif";
        ctx.fillText("Sat: " + ic_sat_mA.toFixed(1) + " mA", padding.left + 8, y1 + 4);

        // Point Blocage sur l'Axe X
        ctx.beginPath();
        ctx.arc(x2, y2, 5, 0, 2 * Math.PI);
        ctx.fillStyle = "#2563eb";
        ctx.fill();
        ctx.fillText("Blocage: " + vce_max.toFixed(1) + " V", x2 - 50, height - padding.bottom + 25);

        // Pointilles Point Q
        var qX = toX(vce_q);
        var qY = toY(ic_q_mA);

        ctx.beginPath();
        ctx.strokeStyle = "#94a3b8"; 
        ctx.setLineDash([4, 4]);
        ctx.moveTo(qX, qY);
        ctx.lineTo(qX, height - padding.bottom);
        ctx.moveTo(qX, qY);
        ctx.lineTo(padding.left, qY);
        ctx.stroke();
        ctx.setLineDash([]); 

        // Point Q
        ctx.beginPath();
        ctx.arc(qX, qY, 6, 0, 2 * Math.PI);
        ctx.fillStyle = "#10b981"; 
        ctx.fill();
        ctx.strokeStyle = "#047857";
        ctx.lineWidth = 1.5;
        ctx.stroke();

        // Texte Point Q
        ctx.fillStyle = "#047857";
        ctx.font = "bold 12px sans-serif";
        ctx.fillText("Point Q (" + vce_q.toFixed(2) + "V, " + ic_q_mA.toFixed(2) + "mA)", qX + 10, qY - 10);
      }

