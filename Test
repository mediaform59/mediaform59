    </section>

    <section class="card span-1">
      <h2>2. Composants du Montage</h2>
      <label>VCC Alimentation (V) <input id="v" type="number" value="12" step="0.1" onchange="simDC()"></label>
      <label>R1 (Haut du pont) (Ω) <input id="r1" type="number" value="4385.5" step="100" onchange="simDC()"></label>
      <label>R2 (Bas du pont) (Ω) <input id="r2" type="number" value="936" step="100" onchange="simDC()"></label>
      <label>RC (Collecteur) (Ω) <input id="rc" type="number" value="216" step="10" onchange="simDC()"></label>
      <label>RE (Émetteur) (Ω) <input id="re" type="number" value="47.6" step="10" onchange="simDC()"></label>
      <label>VCE sat (V) <input id="vsat" type="number" value="0.2" step="0.05" onchange="simDC()"></label>
      <label>PD max (mW) <input id="pdmax" type="number" value="300" step="10" onchange="simDC()"></label>
      <label>Tension Early VA (V) <input id="va" type="number" value="100" step="10" onchange="simDC()"></label>
      <label>Gain β (hFE) <input id="be" type="number" value="150" step="1" onchange="simDC()"></label>
      <label>VBE (V) <input id="vb" type="number" value="0.70" step="0.01" onchange="simDC()"></label>
      
      <!-- NOUVEAU TOGGLE SWITCH EARLY -->
      <div class="switch-container">
        <span class="switch-label">Prise en compte Effet Early ($V_A$)</span>
        <label class="switch">
          <input id="toggleEarly" type="checkbox" checked onchange="simDC()">
          <span class="slider"></span>
        </label>
      </div>
    </section>

    <section class="card span-1">
      <h2>3. Schéma Statique (DC)</h2>
      <canvas id="schematicCanvas" width="360" height="280"></canvas>
    </section>

    <section class="card wide">
      <h2>Mesures au Point de Fonctionnement Q & Modèle Thévenin</h2>
      <div id="resDC" class="results"></div>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-top:12px;">
        <p id="stDC" style="margin:0;"></p>
        <button type="button" class="action-next" style="width:auto;" onclick="transferToAC()">
          ⚡ Transférer ces réglages vers l'Analyse AC (Page 2) ➔
        </button>
      </div>
    </section>

    <section class="card wide">
      <h2>Graphique à 4 Quadrants (Caractéristique Complète du BJT)</h2>
      <canvas id="quadrantsCanvas" width="1200" height="600"></canvas>
    </section>
  </div>
</div>

<!-- PAGE 2 : DYNAMIQUE -->
<div id="tab-ac" class="tab-content">
  <div class="grid">

    <section class="card wide" style="padding:10px 16px; background:#fef3c7; border-color:#f59e0b;">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <span style="color:#92400e; font-weight:bold;">📍 Page 2 : Analyse AC & Aide au Dimensionnement des Condensateurs</span>
        <button type="button" class="action-back" style="width:auto; padding:8px 16px;" onclick="backToDC()">
          ❮ Retourner à la Page 1 (Régime DC)
        </button>
      </div>
    </section>
    
    <section class="card span-1">
      <h2>1. Paramètres Injectés de la Page 1</h2>
      <label>IC de polarisation (mA) <input id="ac_ic" type="number" value="2.0" step="0.1"></label>
      <label>VCE de polarisation (V) <input id="ac_vce" type="number" value="6.0" step="0.1"></label>
      <label>Gain β (hFE) <input id="ac_beta" type="number" value="150" step="5"></label>
      <label>R1 (kΩ) <input id="ac_r1" type="number" value="39" step="0.1"></label>
      <label>R2 (kΩ) <input id="ac_r2" type="number" value="10" step="0.1"></label>
      <label>RC (kΩ) <input id="ac_rc" type="number" value="2.4" step="0.1"></label>
<label>Re1 (non découplée - AC) [Ω] :</label>
<input type="number" id="ac_re1" value="7" oninput="simAC()">
<label>Re2 (découplée par CE - DC) [Ω] :</label>
<input type="number" id="ac_re2" value="40" oninput="simAC()">
      <label>RL Charge Sortie (kΩ) <input id="ac_rl" type="number" value="10" step="0.5"></label>
      <label>RS Résistance Gen. (Ω) <input id="ac_rs" type="number" value="50" step="10"></label>
      <hr style="border:0; border-top:1px solid #e2e8f0; margin:8px 0;">
      <label class="checkbox-label">
        <input id="bypass_ce" type="checkbox" checked onchange="simAC()"> Activer $C_E$ (Découplage Émetteur)
      </label>
    </section>

<!-- SECTION 2 CORRIGÉE -->
    <section class="card span-1">
      <h2>2. Calculateur de Condensateurs</h2>
      <label>Fréquence du signal Fs (Hz) 
        <input id="ac_fsig" type="number" value="10000000" step="100000" oninput="simAC()" onchange="simAC()">
      </label>
      
      <!-- Zone d'affichage des résultats du calcul -->
