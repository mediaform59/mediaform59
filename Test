    </section>

  </div>
</div>

</main>

<script>
function switchTab(tabId) {
  var contents = document.getElementsByClassName("tab-content");
  for (var i = 0; i < contents.length; i++) contents[i].classList.remove("active");
  
  var buttons = document.getElementsByClassName("tab-btn");
  for (var j = 0; j < buttons.length; j++) buttons[j].classList.remove("active");

  document.getElementById(tabId).classList.add("active");
  
  if(tabId === 'tab-dc') {
    buttons[0].classList.add("active");
    simDC();
  } else {
    buttons[1].classList.add("active");
    simAC();
  }
}

function backToDC() { switchTab('tab-dc'); }

const E24 = [1.0, 1.1, 1.2, 1.3, 1.5, 1.6, 1.8, 2.0, 2.2, 2.4, 2.7, 3.0, 3.3, 3.6, 3.9, 4.3, 4.7, 5.1, 5.6, 6.2, 6.8, 7.5, 8.2, 9.1];
const E6_CAPS = [0.1, 0.22, 0.47, 1.0, 2.2, 4.7, 10, 22, 47, 100, 220, 470, 1000];

function getNearestE24(val) {
  if (val <= 0) return val;
  let exponent = Math.floor(Math.log10(val));
  let fraction = val / Math.pow(10, exponent);
  let closest = E24.reduce((prev, curr) => Math.abs(curr - fraction) < Math.abs(prev - fraction) ? curr : prev);
  return closest * Math.pow(10, exponent);
}

// function getNearestCap(valUf) {
//  return E6_CAPS.reduce((prev, curr) => Math.abs(curr - valUf) < Math.abs(prev - valUf) ? curr : prev);
//}

function getNearestCap(valUf) {
  if (!valUf || valUf <= 0 || !isFinite(valUf)) {
    return { uF: 0.01, str: "10 nF" };
  }

  // Tableau E6 de 1 pF à 1000 µF
  var caps = [
    0.000001, 0.0000022, 0.0000047,            // 1pF, 2.2pF, 4.7pF
    0.00001, 0.000022, 0.000047,              // 10pF, 22pF, 47pF
    0.0001, 0.00022, 0.00047,                 // 100pF, 220pF, 470pF
    0.001, 0.0022, 0.0047,                    // 1nF, 2.2nF, 4.7nF
    0.01, 0.022, 0.047,                       // 10nF, 22nF, 47nF
    0.1, 0.22, 0.47,                          // 100nF, 220nF, 470nF
    1, 2.2, 4.7, 10, 22, 47, 100, 220, 1000   // 1µF à 1000µF
  ];

  var target = caps.find(function(c) { return c >= valUf; }) || 1000;
  var formattedStr = "";

  if (target < 0.001) {
    formattedStr = (target * 1e6).toFixed(0) + " pF";
  } else if (target < 1) {
    formattedStr = (target * 1000).toFixed(0) + " nF";
  } else {
    formattedStr = target + " µF";
  }

  return { uF: target, str: formattedStr };
}

function num(id) {
  var el = document.getElementById(id);
  return el ? parseFloat(String(el.value).replace(",", ".")) : 0;
}

function writeValue(id, val) {
  var el = document.getElementById(id);
  if (el) el.value = val;
}

function metric(name, val, unit) {
  return '<div class="metric"><span>' + name + '</span><b>' + val + ' ' + unit + '</b></div>';
}

function calculateDC() {
var vcc = num("v"), r1 = num("r1"), r2 = num("r2");
  var rc = num("rc"), re = num("re"), beta = num("be"), vbe = num("vb");
  var vce_sat = num("vsat"), va = num("va");
  var pd_max = num("pdmax") / 1000;
  var useEarly = document.getElementById("toggleEarly").checked;

  // 1. Modèle de Thévenin
  var vth = vcc * r2 / (r1 + r2);
  var rth = (r1 * r2) / (r1 + r2);

  // 2. Maille d'entrée idéale (Courants fixes)
  var ib = Math.max(0, (vth - vbe) / (rth + (beta + 1) * re));
  var ic = beta * ib;               // Fixé à 25.00 mA si R1/R2/RC/RE sont calculés
  var ie = (beta + 1) * ib;          // 25.21 mA

  // 3. Maille de sortie idéale
  var ve = ie * re;                  // 1.20 V
  var vb_node = ve + vbe;            // 1.95 V
  var vc = vcc - (ic * rc);          // 6.60 V (Tension au noeud Collecteur / GND)
  var vce = vc - ve;                 // 5.40 V (Tension entre Collecteur et Émetteur)

  // 4. Correction Early (Uniquement si activée)
  if (useEarly && va > 0) {
    ic = ic * (1 + Math.max(0, vce) / va);
    vc = vcc - (ic * rc);
    vce = vc - ve;
  }

  var i_pont = vb_node / r2;
  var pd_q = Math.max(0, vce) * ic;
  var ic_sat = (vcc - vce_sat) / (rc + re);

  return {
    vcc: vcc, r1: r1, r2: r2, rc: rc, re: re, beta: beta, vbe: vbe, va: va,
    ib: ib, ic: ic, ie: ie, vce: vce, vc: vc, ve: ve, vb: vb_node,
    vth: vth, rth: rth, i_pont: i_pont, vce_sat: vce_sat, ic_sat: ic_sat,
    pd_q: pd_q, pd_max: pd_max, useEarly: useEarly
  };
}

function designDC() {
var vcc = num("dv"), ic_d = num("di")/1000;
  var beta = num("db"), ve_r = num("df"), k = num("dr"), vbe = num("dbe");

  var ve = vcc * ve_r;
  var vce_d = (vcc - ve) / 2;
  
  // Correction ici : IE = IC * (beta + 1) / beta
  var ie_d = ic_d * (beta + 1) / beta;
  var re = ve / ie_d; 
  
  var vc = ve + vce_d;
  var rc = (vcc - vc) / ic_d;
  var ib = ic_d / beta;
  var vb = ve + vbe;
  var i_r2 = k * ib;
  var r2 = vb / i_r2;
  var r1 = (vcc - vb) / (i_r2 + ib);

  writeValue("v", vcc); writeValue("r1", r1.toFixed(1)); writeValue("r2", r2.toFixed(1));
  writeValue("rc", rc.toFixed(1)); writeValue("re", re.toFixed(1)); writeValue("be", beta); writeValue("vb", vbe);
  writeValue("vsat", num("dvsat")); writeValue("pdmax", num("dpdmax")); writeValue("va", num("dva"));
  simDC();
}

function normalizeE24() {
  writeValue("r1", getNearestE24(num("r1")).toFixed(0));
  writeValue("r2", getNearestE24(num("r2")).toFixed(0));
  writeValue("rc", getNearestE24(num("rc")).toFixed(0));
  writeValue("re", getNearestE24(num("re")).toFixed(0));
  simDC();
}

function simDC() {
  var q = calculateDC();
  document.getElementById("resDC").innerHTML = 
    metric("VCC (Alim)", q.vcc.toFixed(2), "V") +
    metric("VTH (Thévenin)", q.vth.toFixed(2), "V") +
    metric("RTH (Thévenin)", (q.rth / 1000).toFixed(2), "kΩ") +
    metric("Ipont (Pont Base)", (q.i_pont * 1000).toFixed(3), "mA") +
    metric("IB (Base)", (q.ib * 1000).toFixed(3), "mA") +
    metric("IC (Point Q)", (q.ic * 1000).toFixed(2), "mA") +
    metric("IE (Émetteur)", (q.ie * 1000).toFixed(2), "mA") +
    metric("VB (Base/GND)", q.vb.toFixed(2), "V") +
    metric("VC (Col/GND)", q.vc.toFixed(2), "V") +
    metric("VE (Em/GND)", q.ve.toFixed(2), "V") +
    metric("VCE (Point Q)", q.vce.toFixed(2), "V") +
    metric("PD dissipée", (q.pd_q * 1000).toFixed(1), "mW") +
    metric("IC Saturation", (q.ic_sat * 1000).toFixed(2), "mA");

  var stP = document.getElementById("stDC");
  var statusMsg = "";
  if (q.vce <= q.vce_sat) statusMsg += "<span class='danger'>⚠️ Transistor en SATURATION</span>";
  else if (q.ib <= 0.000001 || q.vth <= q.vbe) statusMsg += "<span class='warn'>⚠️ Transistor BLOCÉ (Coupure)</span>";
  else statusMsg += "<span class='ok'>✓ Transistor en RÉGIME ACTIF LINÉAIRE</span>";

  if (q.pd_q > q.pd_max) statusMsg += " — <span class='danger'>⚠️ Surchauffe (PD > PDmax) !</span>";
  else statusMsg += " — <span class='ok'>✓ Puissance autorisée</span>";

  statusMsg += q.useEarly ? " <small style='color:#2563eb;'>(Modèle avec Early $V_A$)</small>" : " <small style='color:#475569;'>(Modèle Idéal)</small>";

  stP.innerHTML = statusMsg;

  drawSchematicDC(q);
  draw4Quadrants(q);
}

function transferToAC() {
  var q = calculateDC();
  writeValue("ac_ic", (q.ic * 1000).toFixed(2));
  writeValue("ac_vce", q.vce.toFixed(2));
  writeValue("ac_beta", q.beta);
  writeValue("ac_r1", (q.r1 / 1000).toFixed(2));
  writeValue("ac_r2", (q.r2 / 1000).toFixed(2));
  writeValue("ac_rc", (q.rc / 1000).toFixed(2));
  writeValue("ac_re", (q.re / 1000).toFixed(2));
  switchTab('tab-ac');
}

function drawSchematicDC(q) {
  var cv = document.getElementById("schematicCanvas");
  var ctx = cv.getContext("2d");
  ctx.clearRect(0, 0, cv.width, cv.height);
  ctx.strokeStyle = "#1e293b"; ctx.lineWidth = 2; ctx.fillStyle = "#0f172a"; ctx.font = "11px Arial";

  ctx.beginPath(); ctx.moveTo(30, 20); ctx.lineTo(270, 20); ctx.stroke();
  ctx.fillText("VCC = " + q.vcc + "V", 30, 15);
  ctx.beginPath(); ctx.moveTo(30, 260); ctx.lineTo(270, 260); ctx.stroke();
  ctx.fillText("GND (0V)", 30, 275);

  var tx = 180, ty = 130;
  ctx.beginPath(); ctx.arc(tx, ty, 18, 0, 2*Math.PI); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(tx - 7, ty - 10); ctx.lineTo(tx - 7, ty + 10); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(80, ty); ctx.lineTo(tx - 7, ty); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(tx + 5, ty - 8); ctx.lineTo(tx + 5, ty - 22); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(tx + 5, ty + 8); ctx.lineTo(tx + 5, ty + 22); ctx.stroke();

  function drawR(x, y, label, val) {
    ctx.fillStyle = "#ffffff"; ctx.fillRect(x - 7, y - 12, 14, 24); ctx.strokeRect(x - 7, y - 12, 14, 24);
    ctx.fillStyle = "#0f172a"; ctx.fillText(label + " (" + val + "Ω)", x + 12, y + 4);
  }

  ctx.beginPath(); ctx.moveTo(80, 20); ctx.lineTo(80, 260); ctx.stroke();
  drawR(80, 60, "R1", q.r1.toFixed(0)); drawR(80, 200, "R2", q.r2.toFixed(0));

  ctx.beginPath(); ctx.moveTo(tx + 5, 20); ctx.lineTo(tx + 5, ty - 22); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(tx + 5, ty + 22); ctx.lineTo(tx + 5, 260); ctx.stroke();
  drawR(tx + 5, 55, "RC", q.rc.toFixed(0)); drawR(tx + 5, 205, "RE", q.re.toFixed(0));

  ctx.fillStyle = "#059669"; ctx.font = "bold 10px Arial";
  ctx.fillText("VB=" + q.vb.toFixed(2) + "V", tx - 65, ty - 6);
  ctx.fillText("VC=" + q.vc.toFixed(2) + "V", tx + 12, ty - 25);
  ctx.fillText("VE=" + q.ve.toFixed(2) + "V", tx + 12, ty + 35);
}

function draw4Quadrants(q) {
  var cv = document.getElementById("quadrantsCanvas");
  var ctx = cv.getContext("2d");
  var w = cv.width, h = cv.height;
  ctx.clearRect(0, 0, w, h);

  var cx = w / 2, cy = h / 2, margin = 50;

  var maxVce = Math.max(q.vcc * 1.15, 12);
  var maxIc = Math.max(q.ic_sat * 1000 * 1.3, (q.ic * 1000) * 1.8, 5);
  var maxIb = Math.max((maxIc / q.beta) * 1.3, (q.ib * 1000) * 2, 0.05);
  var maxVbe = 0.9;

  function px_vce(v) { return cx + (v / maxVce) * (cx - margin); }
  function py_ic(i)  { return cy - (i / maxIc) * (cy - margin); }
  function px_ib(i)  { return cx - (i / maxIb) * (cx - margin); }
  function py_vbe(v) { return cy + (v / maxVbe) * (cy - margin); }

  ctx.strokeStyle = "#334155"; ctx.lineWidth = 1.5;
  ctx.beginPath(); ctx.moveTo(margin / 2, cy); ctx.lineTo(w - margin / 2, cy); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(cx, margin / 2); ctx.lineTo(cx, h - margin / 2); ctx.stroke();

  ctx.fillStyle = "#0f172a"; ctx.font = "bold 12px Arial";
  ctx.fillText("VCE (V) ►", w - 85, cy - 8);
  ctx.fillText("▲ IC (mA)", cx + 8, margin / 2 + 10);
  ctx.fillText("◄ IB (mA)", margin / 2, cy - 8);
  ctx.fillText("▼ VBE (V)", cx + 8, h - margin / 2);

  ctx.fillStyle = "#64748b"; ctx.font = "bold 11px Arial";
  ctx.fillText("QUADRANT 1 : Sortie IC = f(VCE)", cx + 40, 30);
  ctx.fillText("QUADRANT 2 : Transfert IC = β · IB", 40, 30);
  ctx.fillText("QUADRANT 3 : Entrée IB = f(VBE)", 40, h - 20);
  ctx.fillText("QUADRANT 4 : Transconductance IC = f(VBE)", cx + 40, h - 20);

  // Q1 : Zone Saturation + Zone Blocage
  var xSat = px_vce(q.vce_sat);
  ctx.fillStyle = "rgba(220, 38, 38, 0.1)";
  ctx.fillRect(cx, margin/2, xSat - cx, cy - margin/2);
  ctx.fillStyle = "#dc2626"; ctx.font = "10px Arial";
  ctx.fillText("SATURATION", cx + 2, margin/2 + 20);

  ctx.fillStyle = "rgba(217, 119, 6, 0.15)";
  ctx.fillRect(cx, cy - 12, w - margin/2 - cx, 12);
  ctx.fillStyle = "#d97706";
  ctx.fillText("BLOCAGE (Coupure)", w - 160, cy - 3);

  ctx.strokeStyle = "#93c5fd"; ctx.lineWidth = 1.2;
  for (var k = 1; k <= 5; k++) {
    var ib_k = (maxIb / 5) * k;
    ctx.beginPath();
    for (var v = 0; v <= maxVce; v += 0.1) {
      var ic_b = q.beta * ib_k * (1 - Math.exp(-v / 0.3));
      var ic_v = q.useEarly ? ic_b * (1 + v / q.va) : ic_b;
      if (v === 0) ctx.moveTo(px_vce(v), py_ic(ic_v));
      else ctx.lineTo(px_vce(v), py_ic(ic_v));
    }
    ctx.stroke();
  }

  var ic_max_dc = (q.vcc / (q.rc + q.re)) * 1000;
  ctx.strokeStyle = "#2563eb"; ctx.lineWidth = 2;
  ctx.beginPath(); ctx.moveTo(px_vce(0), py_ic(ic_max_dc)); ctx.lineTo(px_vce(q.vcc), py_ic(0)); ctx.stroke();

// ==========================================
  // Q1 : DROITE DE CHARGE + POINTS REMARQUABLES
  // ==========================================

  // 1. Calcul des valeurs physiques aux limites
  var rc = (num("ac_rc") || 0) * 1000;
  var re = ((num("ac_re1") || 0) + (num("ac_re2") || 0));
  var r_total = rc + re;

  // Calcul sécurisé de Vcc et de Ic_sat
  var vcc = num("ac_vcc") || (q ? (q.vce + (q.ic / 1000) * r_total) : 12); 
  var ic_sat_mA = r_total > 0 ? (vcc / r_total) * 1000 : 0;
  var vce_max = vcc;

  // 2. Récupération des fonctions de mapping du Canvas (Q1)
  // On utilise les fonctions de conversion x/y vers pixels si elles existent,
  // sinon on retombe sur drawPoint/Canvas direct.
  var x_sat_px = typeof mapX === "function" ? mapX(1, 0) : (typeof toX === "function" ? toX(0) : null);
  var y_sat_px = typeof mapY === "function" ? mapY(1, ic_sat_mA) : (typeof toY === "function" ? toY(ic_sat_mA) : null);

  var x_bloc_px = typeof mapX === "function" ? mapX(1, vce_max) : (typeof toX === "function" ? toX(vce_max) : null);
  var y_bloc_px = typeof mapY === "function" ? mapY(1, 0) : (typeof toY === "function" ? toY(0) : null);

  // 3. Dessin des étiquettes directement sur les axes (Couleur Bleu Droite de Charge)
  ctx.save();
  ctx.fillStyle = "#2563eb";
  ctx.font = "bold 11px sans-serif";

  // A. Point de Saturation sur l'axe Y (Haut-Gauche de la droite)
  if (x_sat_px !== null && y_sat_px !== null) {
    ctx.beginPath();
    ctx.arc(x_sat_px, y_sat_px, 4, 0, 2 * Math.PI);
    ctx.fill();
    // Affichage à droite de l'axe Y
    ctx.fillText("I_sat = " + ic_sat_mA.toFixed(1) + " mA", x_sat_px + 8, y_sat_px + 4);
  } else {
    // Si pas de fonctions de conversion, appel forcé sur projection
    drawPoint(0, ic_sat_mA, "#2563eb", "I_sat = " + ic_sat_mA.toFixed(1) + " mA");
  }

  // B. Point de Blocage sur l'axe X (Bas-Droite de la droite)
  if (x_bloc_px !== null && y_bloc_px !== null) {
    ctx.beginPath();
    ctx.arc(x_bloc_px, y_bloc_px, 4, 0, 2 * Math.PI);
    ctx.fill();
    // Affichage juste au-dessus du point sur l'axe X
    ctx.fillText("Vcc = " + vce_max.toFixed(1) + " V", x_bloc_px - 30, y_bloc_px - 8);
  } else {
    drawPoint(vce_max, 0, "#2563eb", "Vcc = " + vce_max.toFixed(1) + " V");
  }

  ctx.restore();

  // Q2
  ctx.strokeStyle = "#059669"; ctx.lineWidth = 2;
  ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(px_ib(maxIc / q.beta), py_ic(maxIc)); ctx.stroke();

  // Q3
  ctx.strokeStyle = "#7c3aed"; ctx.lineWidth = 2; ctx.beginPath();
  var first_q3 = true;
  for (var vbe_i = 0; vbe_i <= maxVbe; vbe_i += 0.005) {
    var ib_uA = 0.01 * (Math.exp(vbe_i / 0.026) - 1);
    if (ib_uA <= maxIb) {
      if (first_q3) { ctx.moveTo(px_ib(ib_uA), py_vbe(vbe_i)); first_q3 = false; }
      else ctx.lineTo(px_ib(ib_uA), py_vbe(vbe_i));
    }
  }
  ctx.stroke();

  // Q4
  ctx.strokeStyle = "#db2777"; ctx.lineWidth = 2; ctx.beginPath();
  var first_q4 = true;
  for (var vbe_v = 0; vbe_v <= maxVbe; vbe_v += 0.005) {
    var ic_mA = q.beta * (0.01 * (Math.exp(vbe_v / 0.026) - 1));
    if (ic_mA <= maxIc) {
      var x_q4 = cx + (ic_mA / maxIc) * (cx - margin);
      var y_q4 = py_vbe(vbe_v);
      if (first_q4) { ctx.moveTo(x_q4, y_q4); first_q4 = false; }
      else ctx.lineTo(x_q4, y_q4);
    }
  }
  ctx.stroke();

  // Point Q projections
  var q_ic_mA = q.ic * 1000, q_ib_mA = q.ib * 1000, q_vce_v = q.vce, q_vbe_v = q.vbe;
  var q1_x = px_vce(q_vce_v), q1_y = py_ic(q_ic_mA);
  var q2_x = px_ib(q_ib_mA),  q2_y = py_ic(q_ic_mA);
  var q3_x = px_ib(q_ib_mA),  q3_y = py_vbe(q_vbe_v);
  var q4_x = cx + (q_ic_mA / maxIc) * (cx - margin), q4_y = py_vbe(q_vbe_v);

  ctx.strokeStyle = "#94a3b8"; ctx.lineWidth = 1.5; ctx.setLineDash([4, 4]);
  ctx.beginPath();
  ctx.moveTo(q1_x, q1_y); ctx.lineTo(q2_x, q2_y);
  ctx.lineTo(q3_x, q3_y); ctx.lineTo(q4_x, q4_y);
  ctx.lineTo(q1_x, q1_y); ctx.stroke(); ctx.setLineDash([]);

  function drawPoint(x, y, color, label) {
    ctx.fillStyle = color; ctx.beginPath(); ctx.arc(x, y, 5, 0, 2*Math.PI); ctx.fill();
    if (label) { ctx.font = "bold 11px Arial"; ctx.fillText(label, x + 8, y - 6); }
  }

  drawPoint(q1_x, q1_y, "#059669", "Point Q (" + q_vce_v.toFixed(2) + "V, " + q_ic_mA.toFixed(2) + "mA)");
  drawPoint(q2_x, q2_y, "#059669", null);
  drawPoint(q3_x, q3_y, "#7c3aed", "IB = " + (q_ib_mA * 1000).toFixed(1) + " µA");
  drawPoint(q4_x, q4_y, "#db2777", "VBE = " + q_vbe_v.toFixed(2) + " V");
}

function calculateAC() {
var ic_mA = num("ac_ic"), vce = num("ac_vce"), beta = num("ac_beta");
  var r1 = num("ac_r1") * 1000, r2 = num("ac_r2") * 1000;
  var rc = num("ac_rc") * 1000;

  // Lecture des résistances Re1 (non découplée) et Re2 (découplée par CE)
  var re1 = num("ac_re1"); 
  var re2 = num("ac_re2"); 
  var re_dc = re1 + re2;   

  var rl = num("ac_rl") * 1000, rs = num("ac_rs");
  var c1 = num("ac_c1") * 1e-6, c2 = num("ac_c2") * 1e-6, ce = num("ac_ce") * 1e-6;
  var rx = 10, va = 100, vt_mV = num("ac_vt") || 26;
  var cpi = num("ac_cpi") * 1e-12, cmu = num("ac_cmu") * 1e-12;
  var fsig = num("ac_fsig") || 1000000;

  // Lecture sécurisée de la case à cocher (supporte plusieurs ID possibles)
  var chkCe = document.getElementById("bypass_ce") || document.getElementById("ac_ce_check") || document.querySelector("input[type='checkbox']");
  var has_ce = chkCe ? chkCe.checked : true;

  var ic = ic_mA / 1000, vt = vt_mV / 1000;
  var gm = ic / vt;
  var rpi = beta / gm;
  var ro = (va + Math.max(0.1, vce)) / Math.max(0.00001, ic);
  var re_dyn = vt / Math.max(0.00001, ic);

  var re_ac = has_ce ? re1 : re_dc;

  var rac = (rc * rl) / (rc + rl);
  var z_out_c = (ro * rac) / (ro + rac);

  var rb = (r1 * r2) / (r1 + r2);
  var zb_in = rx + rpi + (beta + 1) * re_ac;
  var zin = (rb * zb_in) / (rb + zb_in);

  var av_int = (re_ac > 0) ? (-rc / (re_ac + re_dyn)) : (-gm * z_out_c);
  var av_sys = av_int * (zin / (zin + rs));
  var av_db = 20 * Math.log10(Math.max(0.0001, Math.abs(av_sys)));

  // CALCUL DIRECT EN FONCTION DE FSIG (Sans limitation à 100 kHz)
  // Coupure cible située à Fs / 10
  var f_target = Math.max(1, fsig / 10);

  var c1_req_uF = (1 / (2 * Math.PI * (rs + zin) * f_target)) * 1e6;
  var c2_req_uF = (1 / (2 * Math.PI * (rc + rl) * f_target)) * 1e6;

  // Impédance vue par le condensateur de découplage CE (autour de Re2)
  var rb_rs = (rb * rs) / (rb + rs);
  var req_ce_num = re2 * (rpi + rb_rs + (beta + 1) * re1);
  var req_ce_den = re2 * (beta + 1) + rpi + rb_rs;
  var req_ce = (req_ce_den > 0 && re2 > 0) ? (req_ce_num / req_ce_den) : 0;

  var ce_req_uF = (has_ce && req_ce > 0) ? ((1 / (2 * Math.PI * req_ce * f_target)) * 1e6) : 0;

  // Calcul des valeurs normalisées (Objet {uF, str})
  var c1_std_obj = getNearestCap(c1_req_uF);
  var c2_std_obj = getNearestCap(c2_req_uF);
  var ce_std_obj = has_ce ? getNearestCap(ce_req_uF) : { uF: 0, str: "N/A" };

  var fl_c1 = 1 / (2 * Math.PI * (rs + zin) * Math.max(1e-12, c1));
  var fl_c2 = 1 / (2 * Math.PI * (rc + rl) * Math.max(1e-12, c2));
  var fl_ce = (has_ce && req_ce > 0) ? (1 / (2 * Math.PI * req_ce * Math.max(1e-12, ce))) : 0;
  var fl_total = Math.max(fl_c1, fl_c2, fl_ce);

  var c_miller = cmu * (1 + Math.abs(av_int));
  var c_in_total = cpi + c_miller;
  var req_h = 1 / ((1 / (rs + rx)) + (1 / rpi) + (1 / rb));
  var fh = 1 / (2 * Math.PI * req_h * Math.max(1e-14, c_in_total));

  return {
    gm: gm, rpi: rpi, ro: ro, rx: rx, zin: zin, z_out_c: z_out_c,
    av_sys: av_sys, av_db: av_db,
    c1_req: c1_req_uF, c2_req: c2_req_uF, ce_req: ce_req_uF,
    c1_std: c1_std_obj.str, c2_std: c2_std_obj.str, ce_std: ce_std_obj.str,
    c1_std_uF: c1_std_obj.uF, c2_std_uF: c2_std_obj.uF, ce_std_uF: ce_std_obj.uF,
    fl: fl_total, fh: fh
  };
}

function applyCalculatedCaps() {
  var p = calculateAC();
  writeValue("ac_c1", p.c1_std);
  writeValue("ac_c2", p.c2_std);
  writeValue("ac_ce", p.ce_std);
  simAC();
}

function simAC() {
var p = calculateAC();
  if (!p) return;

  function formatVal(valUf) {
    if (!valUf || valUf <= 0 || !isFinite(valUf)) return "0 pF";
    if (valUf < 0.001) return (valUf * 1e6).toFixed(1) + " pF";
    if (valUf < 1) return (valUf * 1000).toFixed(1) + " nF";
    return valUf.toFixed(2) + " µF";
  }

  // 1. Injection du texte DANS la carte 2 (Calculateur de Condensateurs)
  var elemCond = document.getElementById("calcCondResults");
  if (elemCond) {
    elemCond.innerHTML = 
      "<div style='margin-top:15px; padding:10px; background:#f0f7ff; border-radius:6px; font-size:13px; color:#333;'>" +
      "<b>Valeurs théoriques requises (pour Fs = " + num("ac_fsig") + " Hz) :</b><br>" +
      "• C1 ≥ <b>" + formatVal(p.c1_req) + "</b> (Normalisé : <b>" + p.c1_std + "</b>)<br>" +
      "• C2 ≥ <b>" + formatVal(p.c2_req) + "</b> (Normalisé : <b>" + p.c2_std + "</b>)<br>" +
      "• CE ≥ <b>" + formatVal(p.ce_req) + "</b> (Normalisé : <b>" + p.ce_std + "</b>)" +
      "</div>";
  }

  // 2. Affichage des métriques électriques
  var elemResAC = document.getElementById("resAC");
  if (elemResAC) {
    elemResAC.innerHTML = 
      metric("Transconductance gm", (p.gm * 1000).toFixed(1), "mA/V") +
      metric("Résistance rπ", p.rpi.toFixed(0), "Ω") +
      metric("Impédance Entrée Zin", (p.zin < 1000 ? p.zin.toFixed(0) + " Ω" : (p.zin/1000).toFixed(2) + " kΩ"), "") +
      metric("Impédance Sortie Zout", (p.z_out_c / 1000).toFixed(2), "kΩ") +
      metric("Gain en Tension Avs", p.av_sys.toFixed(1), "V/V") +
      metric("Gain Avs (dB)", p.av_db.toFixed(1), "dB") +
      metric("Coupure Basse fL", p.fl.toFixed(1), "Hz") +
      metric("Coupure Haute fH", (p.fh / 1e6).toFixed(2), "MHz");
  }

  if (typeof drawACSchematic === "function") drawACSchematic();
  if (typeof drawBode === "function") drawBode(p);

drawLoadLine("bjtCanvas", {
    vcc: num("ac_vcc") || 12,                  // Remplacez 'ac_vcc' par votre ID d'input Vcc s'il est différent
    rc: num("ac_rc") * 1000, 
    re: num("ac_re1") + num("ac_re2"), 
    vce_q: num("ac_vce"), 
    ic_q_mA: num("ac_ic")
  });  
  
}

function applySuggestedCaps() {
  var p = calculateAC();
  if (!p) return;

  // Injection des valeurs normalisées directement dans les champs HTML (en µF)
  var elC1 = document.getElementById("ac_c1");
  var elC2 = document.getElementById("ac_c2");
  var elCE = document.getElementById("ac_ce");

  if (elC1) elC1.value = p.c1_std_uF;
  if (elC2) elC2.value = p.c2_std_uF;
  if (elCE) elCE.value = p.ce_std_uF;

  // Relance la simulation pour mettre à jour les graphiques et coupures
  simAC();
}

function drawACSchematic() {
  var cv = document.getElementById("acSchematicCanvas");
  var ctx = cv.getContext("2d");
  ctx.clearRect(0, 0, cv.width, cv.height);

  ctx.strokeStyle = "#1e293b"; ctx.lineWidth = 2; ctx.fillStyle = "#0f172a"; ctx.font = "11px Arial";

  ctx.beginPath(); ctx.moveTo(150, 20); ctx.lineTo(650, 20); ctx.stroke();
  ctx.fillText("VCC", 150, 15);
  ctx.beginPath(); ctx.moveTo(50, 220); ctx.lineTo(850, 220); ctx.stroke();
  ctx.fillText("GND (Masse AC)", 50, 235);

  ctx.beginPath(); ctx.arc(80, 120, 12, 0, 2*Math.PI); ctx.stroke();
  ctx.fillText("Vin", 72, 124);
  ctx.beginPath(); ctx.moveTo(80, 132); ctx.lineTo(80, 220); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(80, 108); ctx.lineTo(80, 70); ctx.lineTo(120, 70); ctx.stroke();
  
  ctx.strokeRect(120, 62, 24, 16); ctx.fillText("Rs (" + num("ac_rs") + "Ω)", 115, 55);
  ctx.beginPath(); ctx.moveTo(144, 70); ctx.lineTo(180, 70); ctx.stroke();

  ctx.beginPath(); ctx.moveTo(180, 60); ctx.lineTo(180, 80); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(186, 60); ctx.lineTo(186, 80); ctx.stroke();
  ctx.fillText("C1 (" + num("ac_c1") + "µF)", 170, 52);
  ctx.beginPath(); ctx.moveTo(186, 70); ctx.lineTo(300, 70); ctx.stroke();

  ctx.beginPath(); ctx.moveTo(300, 20); ctx.lineTo(300, 220); ctx.stroke();
  ctx.strokeRect(292, 30, 16, 24); ctx.fillText("R1", 315, 45);
  ctx.strokeRect(292, 150, 16, 24); ctx.fillText("R2", 315, 165);

  var tx = 400, ty = 100;
  ctx.beginPath(); ctx.arc(tx, ty, 18, 0, 2*Math.PI); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(tx - 7, ty - 10); ctx.lineTo(tx - 7, ty + 10); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(300, 70); ctx.lineTo(tx - 7, ty); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(tx + 5, ty - 8); ctx.lineTo(tx + 5, ty - 22); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(tx + 5, ty + 8); ctx.lineTo(tx + 5, ty + 22); ctx.stroke();

  ctx.beginPath(); ctx.moveTo(tx + 5, 20); ctx.lineTo(tx + 5, ty - 22); ctx.stroke();
  ctx.strokeRect(tx - 3, 30, 16, 24); ctx.fillText("RC", tx + 20, 45);

  ctx.beginPath(); ctx.moveTo(tx + 5, ty + 22); ctx.lineTo(tx + 5, 220); ctx.stroke();
  ctx.strokeRect(tx - 3, 150, 16, 24); ctx.fillText("RE", tx + 20, 165);

  if (document.getElementById("bypass_ce").checked) {
    ctx.beginPath(); ctx.moveTo(tx + 5, 135); ctx.lineTo(480, 135); ctx.lineTo(480, 220); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(470, 165); ctx.lineTo(490, 165); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(470, 171); ctx.lineTo(490, 171); ctx.stroke();
    ctx.fillText("CE (" + num("ac_ce") + "µF)", 495, 170);
  }

  ctx.beginPath(); ctx.moveTo(tx + 5, 78); ctx.lineTo(580, 78); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(580, 68); ctx.lineTo(580, 88); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(586, 68); ctx.lineTo(586, 88); ctx.stroke();
  ctx.fillText("C2 (" + num("ac_c2") + "µF)", 570, 60);

  ctx.beginPath(); ctx.moveTo(586, 78); ctx.lineTo(680, 78); ctx.lineTo(680, 220); ctx.stroke();
  ctx.strokeRect(672, 110, 16, 28); ctx.fillText("RL (" + num("ac_rl") + "kΩ)", 695, 128);
}

function drawBode(p) {
  var cv = document.getElementById("bodeCanvas");
  var ctx = cv.getContext("2d");
  var w = cv.width, h = cv.height;
  ctx.clearRect(0, 0, w, h);

  var padL = 60, padR = 60, padT = 30, padB = 40;
  var graphW = w - padL - padR, graphH = h - padT - padB;
  var decMin = 0, decMax = 9;

  function getX(f) { return padL + ((Math.log10(Math.max(f, 1)) - decMin) / (decMax - decMin)) * graphW; }
  function getYGain(g) { return padT + graphH - ((g - (-20)) / (60 - (-20))) * graphH; }

  ctx.strokeStyle = "#e2e8f0"; ctx.lineWidth = 1;
  for (var d = decMin; d <= decMax; d++) {
    var x = padL + ((d - decMin) / (decMax - decMin)) * graphW;
    ctx.beginPath(); ctx.moveTo(x, padT); ctx.lineTo(x, h - padB); ctx.stroke();
    ctx.fillStyle = "#64748b"; ctx.font = "10px Arial";
    var label = (d < 3) ? Math.pow(10, d) + "Hz" : ((d < 6) ? Math.pow(10, d-3) + "kHz" : Math.pow(10, d-6) + "MHz");
    ctx.fillText(label, x - 12, h - padB + 15);
  }

  for (var g = -20; g <= 60; g += 20) {
    var y = getYGain(g);
    ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(w - padR, y); ctx.stroke();
    ctx.fillStyle = "#1e3a8a"; ctx.fillText(g + " dB", 15, y + 4);
  }

  ctx.strokeStyle = "#dc2626"; ctx.setLineDash([4, 4]);
  var x_fl = getX(p.fl), x_fh = getX(p.fh);
  ctx.beginPath(); ctx.moveTo(x_fl, padT); ctx.lineTo(x_fl, h - padB); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(x_fh, padT); ctx.lineTo(x_fh, h - padB); ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = "#dc2626"; ctx.font = "bold 11px Arial";
  ctx.fillText("fL=" + p.fl.toFixed(0) + "Hz", x_fl + 5, padT + 15);
  ctx.fillText("fH=" + (p.fh/1e6).toFixed(1) + "MHz", x_fh - 75, padT + 15);

  ctx.strokeStyle = "#2563eb"; ctx.lineWidth = 2.5; ctx.beginPath();
  var first = true;
  for (var px = 0; px <= graphW; px += 2) {
    var f = Math.pow(10, decMin + (px / graphW) * (decMax - decMin));
    var g_total = Math.abs(p.av_sys) * (1 / Math.sqrt(1 + Math.pow(p.fl / f, 2))) * (1 / Math.sqrt(1 + Math.pow(f / p.fh, 2)));
    var g_db = 20 * Math.log10(Math.max(g_total, 1e-4));
    var y_g = getYGain(g_db);
    if (first) { ctx.moveTo(padL + px, y_g); first = false; } else ctx.lineTo(padL + px, y_g);
  }
  ctx.stroke();
}

